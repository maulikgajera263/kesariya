---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { t, LANGS } from '../i18n';
import { SITE, waLink } from '../data/site';
import type { Lang } from '../data/menu';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const home = LANGS.find((l) => l.id === lang)!.href;
const links = [
  { href: '#menu', label: d.nav.menu },
  { href: '#decor', label: d.nav.decor },
  { href: '#occasions', label: d.nav.occasions },
  { href: '#reviews', label: d.nav.reviews },
  { href: '#contact', label: d.nav.contact },
];
const canonical = new URL(home, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.desc} />
    <meta name="theme-color" content="#123426" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l.id} href={new URL(l.href, canonical)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.desc} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FoodEstablishment',
      name: SITE.brand,
      servesCuisine: ['Gujarati', 'Indian', 'Vegetarian'],
      telephone: SITE.phoneTel,
      address: { '@type': 'PostalAddress', streetAddress: '263, Momai Residency, Umragam', addressLocality: 'Surat', postalCode: '394130', addressCountry: 'IN' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">{d.nav.skip}</a>
    <header class="site-head on-green">
      <div class="wrap head-row">
        <a class="brand" href={home} aria-label={SITE.brand}>
          <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="19" fill="#D9A441" />
            <circle cx="20" cy="20" r="15.5" fill="#E9BC5A" stroke="#8A5A14" stroke-width="1" />
            <circle cx="20" cy="9.5" r="4" fill="#E07A2E" /><circle cx="29.5" cy="16" r="4" fill="#5A2812" />
            <circle cx="27" cy="27.5" r="4" fill="#F08A24" /><circle cx="13" cy="27.5" r="4" fill="#2F7D3A" />
            <circle cx="10.5" cy="16" r="4" fill="#F8D36A" /><circle cx="20" cy="20" r="4.5" fill="#F8E7BE" />
          </svg>
          <span class="brand-text">
            <span class="brand-name">Kesariya</span>
            <span class="brand-sub">Catering · Surat</span>
          </span>
        </a>

        <nav class="nav-desktop" aria-label="Main">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>

        <div class="head-actions">
          <div class="lang" role="group" aria-label={d.nav.lang}>
            {LANGS.map((l) => (
              <a href={l.href} lang={l.id} aria-current={l.id === lang ? 'true' : undefined}>{l.label}</a>
            ))}
          </div>
          <a class="btn btn-primary head-cta" href="#plan">{d.nav.cta}</a>
          <details class="nav-mobile">
            <summary aria-label={d.nav.open}><Icon name="menu" size={24} /></summary>
            <div class="sheet">
              <nav aria-label="Main">
                {links.map((l) => <a href={l.href}>{l.label}</a>)}
              </nav>
              <div class="sheet-lang" role="group" aria-label={d.nav.lang}>
                {LANGS.map((l) => (
                  <a href={l.href} lang={l.id} aria-current={l.id === lang ? 'true' : undefined}>{l.label}</a>
                ))}
              </div>
              <a class="btn btn-primary" href="#plan">{d.nav.cta}</a>
              <a class="sheet-phone" href={`tel:${SITE.phoneTel}`}><Icon name="phone" size={18} /> {SITE.phoneDisplay}</a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot on-green">
      <div class="wrap foot-grid">
        <div>
          <p class="foot-brand display">Kesariya</p>
          <p class="foot-tag">{d.footer.tagline}</p>
        </div>
        <div class="foot-contact">
          <a href={`tel:${SITE.phoneTel}`}><Icon name="phone" size={18} /> {SITE.phoneDisplay}</a>
          <a href={waLink(d.wa.hello)} rel="noopener" target="_blank"><Icon name="message" size={18} /> WhatsApp</a>
          <a href={SITE.mapUrl} rel="noopener" target="_blank"><Icon name="pin" size={18} /> {SITE.address}</a>
        </div>
        <div class="foot-meta">
          <div class="lang" role="group" aria-label={d.nav.lang}>
            {LANGS.map((l) => (
              <a href={l.href} lang={l.id} aria-current={l.id === lang ? 'true' : undefined}>{l.label}</a>
            ))}
          </div>
          <p>© {new Date().getFullYear()} {d.footer.rights} · <a href="/admin">{d.footer.portal}</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 1rem; top: -4rem; z-index: 100;
    background: var(--haldi); color: var(--mehndi-950);
    padding: 0.6rem 1rem; border-radius: 8px; font-weight: 650;
  }
  .skip:focus { top: 1rem; }

  .site-head {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--mehndi-900) 94%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    color: var(--on-green);
    border-bottom: 1px solid var(--rule-on-green);
  }
  .head-row { display: flex; align-items: center; gap: var(--s-5); min-height: 72px; }
  .brand { display: flex; align-items: center; gap: 0.65rem; text-decoration: none; }
  .brand-mark { width: 40px; height: 40px; }
  .brand-text { display: grid; line-height: 1.05; }
  .brand-name { font-stretch: 120%; font-weight: 780; font-size: 1.35rem; letter-spacing: -0.01em; }
  .brand-sub { font-size: 0.78rem; color: var(--on-green-soft); font-weight: 500; letter-spacing: 0.02em; }

  .nav-desktop { display: flex; gap: var(--s-5); margin-left: auto; }
  .nav-desktop a {
    text-decoration: none; font-weight: 520; color: var(--on-green-soft);
    padding: 0.4rem 0; border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .nav-desktop a:hover { color: var(--on-green); border-color: var(--brass); }

  .head-actions { display: flex; align-items: center; gap: var(--s-4); }
  .lang { display: flex; gap: 2px; padding: 3px; border-radius: 999px; border: 1px solid var(--rule-on-green); }
  .lang a {
    text-decoration: none; font-size: 0.85rem; padding: 0.25rem 0.6rem; border-radius: 999px;
    color: var(--on-green-soft); font-weight: 550; line-height: 1.5;
  }
  .lang a:hover { color: var(--on-green); }
  .lang a[aria-current='true'] { background: var(--brass); color: var(--mehndi-950); }
  .head-cta { min-height: 42px; padding: 0.5rem 1.15rem; }

  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary {
    list-style: none; display: grid; place-items: center;
    width: 48px; height: 48px; border-radius: 12px; cursor: pointer;
    border: 1px solid var(--rule-on-green);
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .sheet {
    position: absolute; right: 0; top: calc(100% + 10px);
    width: min(320px, calc(100vw - 2rem));
    background: var(--mehndi-950); border: 1px solid var(--rule-on-green);
    border-radius: var(--radius); box-shadow: var(--shadow-2);
    padding: var(--s-4); display: grid; gap: var(--s-4);
  }
  .sheet nav { display: grid; }
  .sheet nav a { padding: 0.7rem 0.25rem; text-decoration: none; font-size: 1.15rem; font-weight: 600; border-bottom: 1px solid var(--rule-on-green); }
  .sheet-lang { display: flex; gap: 0.5rem; }
  .sheet-lang a { flex: 1; text-align: center; padding: 0.5rem; border-radius: 10px; border: 1px solid var(--rule-on-green); text-decoration: none; }
  .sheet-lang a[aria-current='true'] { background: var(--brass); color: var(--mehndi-950); border-color: var(--brass); }
  .sheet-phone { display: flex; align-items: center; justify-content: center; gap: 0.5rem; color: var(--on-green-soft); text-decoration: none; }

  @media (max-width: 1080px) {
    .nav-desktop { display: none; }
    .head-actions { margin-left: auto; }
  }
  @media (max-width: 720px) {
    .head-actions > .lang, .head-cta { display: none; }
    .nav-mobile { display: block; }
  }

  .site-foot { background: var(--mehndi-950); color: var(--on-green); padding-block: var(--s-8) var(--s-6); }
  .foot-grid { display: grid; grid-template-columns: 1.1fr 1.4fr 1fr; gap: var(--s-6); align-items: start; }
  .foot-brand { font-size: var(--step-3); color: var(--brass-light); }
  .foot-tag { color: var(--on-green-soft); margin-top: var(--s-2); }
  .foot-contact { display: grid; gap: var(--s-3); }
  .foot-contact a { display: flex; gap: 0.6rem; align-items: flex-start; text-decoration: none; }
  .foot-contact a:hover { color: var(--brass-light); }
  .foot-contact :global(.icon) { margin-top: 0.25rem; color: var(--brass); }
  .foot-meta { display: grid; gap: var(--s-4); justify-items: start; color: var(--on-green-soft); font-size: var(--step--1); }
  @media (max-width: 860px) { .foot-grid { grid-template-columns: 1fr; } }
</style>

---
import Portal from '../../layouts/Portal.astro';
import { checkPassword, isLoggedIn, portalConfigured, rateLimited, startSession } from '../../lib/auth';

if (isLoggedIn(Astro.cookies)) return Astro.redirect('/admin', 303);

let error = '';
if (Astro.request.method === 'POST') {
  if (rateLimited('login:' + Astro.clientAddress, 5, 15 * 60_000)) {
    error = 'Too many attempts. Please wait 15 minutes and try again.';
  } else {
    const form = await Astro.request.formData();
    if (checkPassword(String(form.get('password') || ''))) {
      startSession(Astro.cookies, Astro.url.protocol === 'https:');
      return Astro.redirect('/admin', 303);
    }
    error = 'That password is not right. Please try again.';
  }
}
const configured = portalConfigured();
---
<Portal title="Log in">
  <main class="login">
    <div class="card">
      <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="19" fill="#D9A441" /><circle cx="20" cy="20" r="15.5" fill="#E9BC5A" stroke="#8A5A14" />
        <circle cx="20" cy="9.5" r="4" fill="#E07A2E" /><circle cx="29.5" cy="16" r="4" fill="#5A2812" />
        <circle cx="27" cy="27.5" r="4" fill="#F08A24" /><circle cx="13" cy="27.5" r="4" fill="#2F7D3A" />
        <circle cx="10.5" cy="16" r="4" fill="#F8D36A" /><circle cx="20" cy="20" r="4.5" fill="#F8E7BE" />
      </svg>
      <h1>Owner portal</h1>
      <p class="sub">Kesariya Catering inquiries</p>

      {configured ? (
        <form method="post">
          {error && <p class="alert" role="alert">{error}</p>}
          <label class="field">
            <span>Password</span>
            <input class="input" type="password" name="password" autocomplete="current-password" required autofocus />
          </label>
          <button class="btn btn-ink" type="submit">Log in</button>
        </form>
      ) : (
        <p class="alert" role="alert">
          The portal password is not set yet. Set <code>ADMIN_PASSWORD</code> (at least 8 characters) on the
          server and restart it. See the README for details.
        </p>
      )}
      <a class="back" href="/">Back to the website</a>
    </div>
  </main>
</Portal>

<style>
  .login { min-height: 100svh; display: grid; place-items: center; padding: var(--gutter); background: var(--mehndi-900); }
  .card {
    width: min(400px, 100%); background: var(--chaas); border-radius: 20px; padding: var(--s-6);
    display: grid; gap: var(--s-4); box-shadow: var(--shadow-2);
  }
  .mark { width: 48px; height: 48px; }
  h1 { font-size: var(--step-2); }
  .sub { color: var(--ink-soft); margin-top: calc(-1 * var(--s-3)); }
  form { display: grid; gap: var(--s-4); }
  .alert { background: #fbe6e1; color: #7a1d10; padding: var(--s-3) var(--s-4); border-radius: 10px; font-weight: 550; }
  code { font-weight: 700; }
  .back { color: var(--ink-soft); font-size: var(--step--1); justify-self: start; }
</style>

---
import Portal from '../../layouts/Portal.astro';
import Icon from '../../components/Icon.astro';
import { isLoggedIn, endSession } from '../../lib/auth';
import { listLeads, setStatus, deleteLead, type Lead } from '../../lib/store';
import { STATUSES, type Status } from '../../data/site';
import { itemName } from '../../data/menu';

if (!isLoggedIn(Astro.cookies)) return Astro.redirect('/admin/login', 303);

// Actions post back to this page, then redirect so a refresh never repeats them.
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action'));
  const id = String(f.get('id') || '');
  const back = String(f.get('back') || '/admin');
  if (action === 'logout') {
    endSession(Astro.cookies);
    return Astro.redirect('/admin/login', 303);
  }
  if (action === 'status' && STATUSES.includes(f.get('status') as Status)) {
    await setStatus(id, f.get('status') as Status);
  }
  if (action === 'delete') await deleteLead(id);
  return Astro.redirect(back.startsWith('/admin') ? back : '/admin', 303);
}

const all = await listLeads();
const q = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();
const statusFilter = Astro.url.searchParams.get('status') || '';
const counts = Object.fromEntries(STATUSES.map((s) => [s, all.filter((l) => (l.status || 'New') === s).length]));
const leads = all.filter((l) => {
  if (statusFilter && (l.status || 'New') !== statusFilter) return false;
  if (!q) return true;
  return [l.id, l.fullName, l.phone, l.city, l.eventType, l.specialNotes].join(' ').toLowerCase().includes(q);
});
const back = Astro.url.pathname + Astro.url.search;

const fmtDate = (iso?: string) =>
  iso ? new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
const eventDate = (s?: string) =>
  s && /^\d{4}-\d{2}-\d{2}$/.test(s) ? fmtDate(s + 'T00:00:00') : s || 'Date not set';
const digits = (l: Lead) => (l.whatsapp || l.phone || '').replace(/\D/g, '');
const waNumber = (l: Lead) => (digits(l).length === 10 ? '91' + digits(l) : digits(l));
const waText = (l: Lead) =>
  encodeURIComponent(
    `Namaste ${l.fullName}, this is Bharatbhai Gajera from Kesariya Catering. Thank you for your inquiry` +
      (l.eventType ? ` for your ${l.eventType.toLowerCase()}` : '') +
      (l.eventDate ? ` on ${eventDate(l.eventDate)}` : '') +
      ` (ref ${l.id}). When is a good time to talk about the menu?`,
  );
const tabHref = (s: string) => {
  const p = new URLSearchParams();
  if (s) p.set('status', s);
  if (q) p.set('q', q);
  const qs = p.toString();
  return '/admin' + (qs ? '?' + qs : '');
};
---
<Portal title="Inquiries">
  <header class="bar on-green">
    <div class="wrap bar-row">
      <a class="title" href="/admin">
        <svg viewBox="0 0 40 40" aria-hidden="true" class="mark"><circle cx="20" cy="20" r="19" fill="#D9A441" /><circle cx="20" cy="20" r="15.5" fill="#E9BC5A" stroke="#8A5A14" /><circle cx="20" cy="9.5" r="4" fill="#E07A2E" /><circle cx="29.5" cy="16" r="4" fill="#5A2812" /><circle cx="27" cy="27.5" r="4" fill="#F08A24" /><circle cx="13" cy="27.5" r="4" fill="#2F7D3A" /><circle cx="10.5" cy="16" r="4" fill="#F8D36A" /><circle cx="20" cy="20" r="4.5" fill="#F8E7BE" /></svg>
        <span>Inquiries</span>
      </a>
      <div class="bar-actions">
        <a class="bar-link" href="/admin/leads.csv"><Icon name="download" size={18} /> <span>Export CSV</span></a>
        <a class="bar-link" href="/" target="_blank" rel="noopener"><span>Website</span></a>
        <form method="post"><input type="hidden" name="action" value="logout" />
          <button class="bar-link" type="submit"><Icon name="logout" size={18} /> <span>Log out</span></button>
        </form>
      </div>
    </div>
  </header>

  <main class="wrap main">
    <div class="tools">
      <nav class="tabs" aria-label="Filter by status">
        <a href={tabHref('')} aria-current={!statusFilter ? 'page' : undefined}>All <span class="num">{all.length}</span></a>
        {STATUSES.map((s) => (
          <a href={tabHref(s)} aria-current={statusFilter === s ? 'page' : undefined} class={`t-${s.toLowerCase()}`}>
            {s === 'New' ? 'Call back' : s} <span class="num">{counts[s]}</span>
          </a>
        ))}
      </nav>
      <form class="search" role="search" method="get">
        {statusFilter && <input type="hidden" name="status" value={statusFilter} />}
        <label class="visually-hidden" for="q">Search inquiries</label>
        <Icon name="search" size={18} />
        <input id="q" class="input" type="search" name="q" value={q} placeholder="Name, phone, area, ref…" />
      </form>
    </div>

    {leads.length === 0 ? (
      <div class="empty">
        <h2>{all.length === 0 ? 'No inquiries yet' : 'Nothing matches'}</h2>
        <p>{all.length === 0
          ? 'New inquiries from the website will appear here as soon as they are sent.'
          : 'Try another name or number, or clear the filter.'}</p>
        {all.length > 0 && <a class="btn btn-ink" href="/admin">Show all inquiries</a>}
      </div>
    ) : (
      <ol class="leads" role="list">
        {leads.map((l) => (
          <li class={`lead s-${(l.status || 'New').toLowerCase()}`}>
            <div class="who">
              <p class="name">{l.fullName}</p>
              <a class="phone num" href={`tel:${digits(l)}`}>{l.phone}</a>
              <p class="meta">{l.city || 'Area not given'}</p>
            </div>
            <div class="what">
              <p class="event">{l.eventType || 'Celebration'}</p>
              <p class="meta">
                <Icon name="calendar" size={16} /> {eventDate(l.eventDate)}
                {l.guestCount ? <> · <Icon name="users" size={16} /> <span class="num">{l.guestCount}</span> guests</> : null}
              </p>
              {(l.thali?.length || l.services?.length) ? (
                <details class="more">
                  <summary>Menu and notes</summary>
                  {l.services?.length ? <p><strong>Needs:</strong> {l.services.join(', ')}</p> : null}
                  {l.thali?.length ? <p><strong>Thali:</strong> {l.thali.map((id) => itemName(id)).join(', ')}</p> : null}
                  {l.decorTheme ? <p><strong>Décor:</strong> {l.decorTheme}</p> : null}
                  {l.specialNotes ? <p><strong>Notes:</strong> {l.specialNotes}</p> : null}
                  {l.lang && l.lang !== 'en' ? <p><strong>Language:</strong> {l.lang === 'gu' ? 'Gujarati' : 'Hindi'}</p> : null}
                </details>
              ) : l.specialNotes ? <p class="meta note">{l.specialNotes}</p> : null}
            </div>
            <div class="status">
              <form method="post" class="status-form">
                <input type="hidden" name="action" value="status" />
                <input type="hidden" name="id" value={l.id} />
                <input type="hidden" name="back" value={back} />
                <label class="visually-hidden" for={`st-${l.id}`}>Status for {l.fullName}</label>
                <select class="input" id={`st-${l.id}`} name="status" data-autosubmit>
                  {STATUSES.map((s) => <option selected={(l.status || 'New') === s}>{s}</option>)}
                </select>
                <noscript><button class="btn btn-ink small" type="submit">Save</button></noscript>
              </form>
              <p class="meta ref"><span class="num">{l.id}</span> · {fmtDate(l.timestamp)}</p>
            </div>
            <div class="acts">
              <a class="act call" href={`tel:${digits(l)}`}><Icon name="phone" size={18} /> Call</a>
              <a class="act wa" href={`https://wa.me/${waNumber(l)}?text=${waText(l)}`} target="_blank" rel="noopener"><Icon name="message" size={18} /> WhatsApp</a>
              <form method="post" data-confirm={`Delete the inquiry from ${l.fullName}? This cannot be undone.`}>
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={l.id} />
                <input type="hidden" name="back" value={back} />
                <button class="act del" type="submit" aria-label={`Delete inquiry from ${l.fullName}`}><Icon name="trash" size={18} /></button>
              </form>
            </div>
          </li>
        ))}
      </ol>
    )}
  </main>
</Portal>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-autosubmit]').forEach((s) =>
    s.addEventListener('change', () => s.form?.requestSubmit()),
  );
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      if (!confirm(f.dataset.confirm || 'Are you sure?')) e.preventDefault();
    }),
  );
  const search = document.querySelector<HTMLInputElement>('#q');
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') { e.preventDefault(); search?.focus(); }
  });
</script>

<style>
  .bar { background: var(--mehndi-900); color: var(--on-green); position: sticky; top: 0; z-index: 10; }
  .bar-row { display: flex; align-items: center; gap: var(--s-4); min-height: 64px; }
  .title { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-stretch: 114%; font-weight: 740; font-size: 1.2rem; }
  .mark { width: 34px; height: 34px; }
  .bar-actions { margin-left: auto; display: flex; align-items: center; gap: var(--s-2); }
  .bar-link {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 40px; padding: 0.3rem 0.75rem;
    border-radius: 10px; color: var(--on-green-soft); text-decoration: none; background: none; border: 0; cursor: pointer; font-weight: 550;
  }
  .bar-link:hover { color: var(--on-green); background: rgba(244, 245, 239, 0.08); }

  .main { padding-block: var(--s-6) var(--s-9); }
  .tools { display: flex; flex-wrap: wrap; gap: var(--s-4); align-items: center; justify-content: space-between; margin-bottom: var(--s-5); }
  .tabs { display: flex; flex-wrap: wrap; gap: var(--s-1); padding: 4px; background: var(--chaas-2); border-radius: 12px; }
  .tabs a {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 40px; padding: 0.35rem 0.85rem;
    border-radius: 9px; text-decoration: none; font-weight: 600; color: var(--ink-soft);
  }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-current='page'] { background: #fff; color: var(--ink); box-shadow: var(--shadow-1); }
  .tabs .num { font-size: 0.8rem; min-width: 1.6rem; text-align: center; padding: 0 0.4rem; border-radius: 999px; background: rgba(19, 36, 26, 0.08); }
  .tabs .t-new .num { background: var(--kesar); color: var(--mehndi-950); }
  .search { position: relative; flex: 1 1 260px; max-width: 380px; }
  .search :global(.icon) { position: absolute; left: 0.85rem; top: 50%; translate: 0 -50%; color: var(--ink-soft); }
  .search .input { padding-left: 2.5rem; }

  .leads { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--rule); }
  .lead {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr) 11rem auto;
    gap: var(--s-5); align-items: start; padding: var(--s-5) var(--s-4);
    border-bottom: 1px solid var(--rule); background: #fff;
  }
  .lead.s-new { background: #fff8e6; }
  .lead.s-closed { background: transparent; color: var(--ink-soft); }
  .name { font-weight: 680; font-size: 1.05rem; }
  .phone { font-weight: 600; color: var(--mehndi-800); text-decoration: none; }
  .phone:hover { text-decoration: underline; }
  .meta { color: var(--ink-soft); font-size: var(--step--1); display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; }
  .event { font-weight: 620; }
  .note { margin-top: 0.3rem; }
  .more { margin-top: var(--s-2); font-size: var(--step--1); }
  .more summary { cursor: pointer; color: var(--brass-deep); font-weight: 600; min-height: 32px; display: inline-flex; align-items: center; }
  .more p { margin-top: 0.3rem; max-width: 60ch; }
  .status-form .input { min-height: 40px; padding-block: 0.4rem; }
  .ref { margin-top: 0.4rem; }
  .acts { display: flex; gap: var(--s-2); align-items: center; }
  .act {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 40px; padding: 0.35rem 0.8rem;
    border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 0.95rem;
    border: 1.5px solid var(--rule); background: #fff; cursor: pointer; color: var(--ink);
    transition: background-color 0.2s, border-color 0.2s;
  }
  .act.call { background: var(--mehndi-900); color: var(--on-green); border-color: var(--mehndi-900); }
  .act.call:hover { background: var(--mehndi-700); }
  .act.wa:hover { border-color: var(--leaf); color: var(--leaf); }
  .act.del { padding-inline: 0.6rem; color: var(--ink-soft); }
  .act.del:hover { color: var(--chilli); border-color: var(--chilli); }

  .empty { padding: var(--s-9) var(--s-4); text-align: center; display: grid; gap: var(--s-3); justify-items: center; }
  .empty h2 { font-size: var(--step-2); }
  .empty p { color: var(--ink-soft); max-width: 40ch; }

  @media (max-width: 1000px) {
    .lead { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .acts { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .bar-link span { display: none; }
    .lead { grid-template-columns: 1fr; gap: var(--s-3); padding-inline: var(--s-3); }
    .acts .act.call, .acts .act.wa { flex: 1; justify-content: center; }
    .search { max-width: none; }
  }
</style>

---
// A top-down brass Gujarati thali, drawn in SVG.
// mode="full": every katori is filled (hero).
// mode="build": katoris start empty and fill as the visitor picks dishes.
interface Props {
  uid: string;
  mode?: 'full' | 'build';
  label: string;
  class?: string;
}
const { uid, mode = 'full', label, class: cls = '' } = Astro.props;
const u = (s: string) => `${uid}-${s}`;

import { KATORIS as katoris } from '../data/thali';
const C = 320;

// Hammered-brass dents, placed deterministically.
const dents: { x: number; y: number; r: number; o: number }[] = [];
for (let i = 0; i < 160; i++) {
  const t = i * 2.399963;
  const rr = 262 * Math.sqrt((i + 0.5) / 160);
  dents.push({
    x: +(C + rr * Math.cos(t)).toFixed(1),
    y: +(C + rr * Math.sin(t)).toFixed(1),
    r: 5 + ((i * 7) % 5),
    o: 0.05 + ((i * 13) % 7) / 100,
  });
}
// A jalebi coil: an Archimedean spiral drawn as one stroke.
const spiral = (turns: number, gap: number) => {
  const pts: string[] = [];
  for (let t = 0; t <= turns * Math.PI * 2; t += 0.25) {
    const r = 1.5 + (gap * t) / (Math.PI * 2);
    pts.push(`${(r * Math.cos(t)).toFixed(1)} ${(r * Math.sin(t)).toFixed(1)}`);
  }
  return 'M' + pts.join(' L');
};
// Rice grains spread over the biryani mound.
const grains = Array.from({ length: 120 }, (_, i) => {
  const t = i * 2.399963;
  const r = 62 * Math.sqrt((i + 0.5) / 120);
  return { x: +(296 + r * 1.15 * Math.cos(t)).toFixed(1), y: +(282 + r * 0.85 * Math.sin(t)).toFixed(1), a: (i * 47) % 180, k: i };
});
const ring = (n: number, r: number, off = 0) =>
  Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2 + off;
    return { x: +(r * Math.cos(a)).toFixed(2), y: +(r * Math.sin(a)).toFixed(2), a: (a * 180) / Math.PI };
  });
---
<svg
  class:list={['thali', cls]}
  data-mode={mode}
  viewBox="0 0 640 640"
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={u('rim')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FBE6A6" />
      <stop offset=".22" stop-color="#D9A441" />
      <stop offset=".48" stop-color="#9C6A1C" />
      <stop offset=".7" stop-color="#E8BE5E" />
      <stop offset="1" stop-color="#7A4E10" />
    </linearGradient>
    <radialGradient id={u('bed')} cx=".38" cy=".34" r=".75">
      <stop offset="0" stop-color="#F4CF77" />
      <stop offset=".55" stop-color="#D6A445" />
      <stop offset="1" stop-color="#A9762A" />
    </radialGradient>
    <linearGradient id={u('krim')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFF0B8" />
      <stop offset=".35" stop-color="#E2AE4C" />
      <stop offset=".7" stop-color="#94621A" />
      <stop offset="1" stop-color="#C9963C" />
    </linearGradient>
    <radialGradient id={u('kin')} cx=".62" cy=".66" r=".7">
      <stop offset="0" stop-color="#F2C96A" />
      <stop offset="1" stop-color="#A06E22" />
    </radialGradient>
    <radialGradient id={u('gravy')} cx=".45" cy=".4" r=".65">
      <stop offset="0" stop-color="#F3A551" />
      <stop offset="1" stop-color="#C9561C" />
    </radialGradient>
    <radialGradient id={u('dal')} cx=".45" cy=".4" r=".65">
      <stop offset="0" stop-color="#8A4422" />
      <stop offset="1" stop-color="#4A200E" />
    </radialGradient>
    <radialGradient id={u('puri')} cx=".35" cy=".3" r=".8">
      <stop offset="0" stop-color="#F6CB78" />
      <stop offset="1" stop-color="#B8742A" />
    </radialGradient>
    <radialGradient id={u('sharbat')} cx=".4" cy=".35" r=".7">
      <stop offset="0" stop-color="#FBE3A2" />
      <stop offset="1" stop-color="#E6A93C" />
    </radialGradient>
    <radialGradient id={u('roti')} cx=".4" cy=".35" r=".75">
      <stop offset="0" stop-color="#EDC17A" />
      <stop offset="1" stop-color="#C08440" />
    </radialGradient>
    <clipPath id={u('kclip')}><circle r="51" /></clipPath>
    <clipPath id={u('bedclip')}><circle cx={C} cy={C} r="266" /></clipPath>
    <filter id={u('drop')} x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="14" stdDeviation="14" flood-color="#06140D" flood-opacity=".55" />
    </filter>
    <filter id={u('kdrop')} x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="3" dy="6" stdDeviation="5" flood-color="#5A3508" flood-opacity=".45" />
    </filter>
  </defs>

  <!-- plate -->
  <g filter={`url(#${u('drop')})`}>
    <circle cx={C} cy={C} r="302" fill={`url(#${u('rim')})`} />
  </g>
  <circle cx={C} cy={C} r="290" fill="none" stroke="#FFF3C4" stroke-opacity=".55" stroke-width="1.5" stroke-dasharray="1.5 7" />
  <circle cx={C} cy={C} r="268" fill={`url(#${u('bed')})`} stroke="#7A4E10" stroke-opacity=".55" stroke-width="2.5" />
  <g clip-path={`url(#${u('bedclip')})`} aria-hidden="true">
    {dents.map((d) => (
      <ellipse cx={d.x} cy={d.y} rx={d.r} ry={d.r * 0.8} fill="#FFF6D2" fill-opacity={d.o} />
    ))}
    <ellipse cx="236" cy="200" rx="150" ry="70" fill="#FFF8DC" fill-opacity=".16" transform="rotate(-35 236 200)" />
  </g>

  <!-- centre: rotis and biryani -->
  <g class="katori center" data-katori="roti">
    <g class="food">
      <g transform="translate(372 352)">
        <circle r="62" fill={`url(#${u('roti')})`} stroke="#9A6128" stroke-width="1.5" />
        {ring(9, 36, 0.4).map((p) => <ellipse cx={p.x} cy={p.y} rx="6" ry="4" fill="#7E4A1A" fill-opacity=".55" transform={`rotate(${p.a} ${p.x} ${p.y})`} />)}
        {ring(5, 14, 1).map((p) => <ellipse cx={p.x} cy={p.y} rx="4" ry="3" fill="#7E4A1A" fill-opacity=".45" />)}
        <ellipse cx="-16" cy="-20" rx="26" ry="12" fill="#FFF2C6" fill-opacity=".35" transform="rotate(-30 -16 -20)" />
      </g>
      <g transform="translate(332 384)">
        <circle r="58" fill={`url(#${u('roti')})`} stroke="#9A6128" stroke-width="1.5" />
        {ring(8, 32, 0.9).map((p) => <ellipse cx={p.x} cy={p.y} rx="5" ry="3.5" fill="#7E4A1A" fill-opacity=".5" transform={`rotate(${p.a} ${p.x} ${p.y})`} />)}
        <ellipse cx="-14" cy="-18" rx="22" ry="10" fill="#FFF2C6" fill-opacity=".4" transform="rotate(-30 -14 -18)" />
      </g>
    </g>
  </g>
  <g class="katori center" data-katori="rice">
    <g class="food">
      <ellipse cx="300" cy="290" rx="80" ry="62" fill="#5A3A10" fill-opacity=".18" />
      <ellipse cx="296" cy="282" rx="76" ry="56" fill="#F7E6BC" />
      <path d="M244 262c16-18 44-22 60-12-8 18-30 26-50 24-8-1-12-5-10-12z" fill="#F0A537" fill-opacity=".8" />
      <path d="M306 300c18-8 40-2 50 10-16 12-38 12-52 2z" fill="#E98E22" fill-opacity=".6" />
      {grains.map((g) => (
        <ellipse cx={g.x} cy={g.y} rx="5.2" ry="1.7" transform={`rotate(${g.a} ${g.x} ${g.y})`}
          fill={g.k % 5 === 0 ? '#EF9A2A' : g.k % 3 === 0 ? '#FFFFFF' : '#FCF3DC'} stroke="#D9BF86" stroke-width=".5" />
      ))}
      {[[262, 298], [322, 256], [338, 296], [276, 252]].map(([x, y]) => <path d={`M${x} ${y}l5 -4 5 4 -5 4z`} fill="#2F7D3A" />)}
      {[[290, 312], [312, 270]].map(([x, y]) => <ellipse cx={x} cy={y} rx="6" ry="3" fill="#C9822F" />)}
      <path d="M242 330c18 9 32 7 44-4" stroke="#3E8E3E" stroke-width="6" stroke-linecap="round" fill="none" />
      <path d="M232 318a24 24 0 0 1 40-12l-40 12z" fill="#F4E04D" stroke="#C9B11E" stroke-width="1.5" />
    </g>
  </g>

  <!-- katoris around the rim -->
  {katoris.map((k) => (
    <g class="katori" data-katori={k.id} transform={`translate(${k.x} ${k.y})`}>
      <g filter={`url(#${u('kdrop')})`}><circle r="64" fill={`url(#${u('krim')})`} /></g>
      <circle r="57" fill="#8E5D16" />
      <circle r="52" fill={`url(#${u('kin')})`} />
      <g class="food" clip-path={`url(#${u('kclip')})`}>
        {k.id === 'sabzi' && (
          <>
            <circle r="52" fill={`url(#${u('gravy')})`} />
            <path d="M-30 -6c14-16 34-14 44 0s30 14 38 0" stroke="#FFF0D6" stroke-width="3" fill="none" stroke-linecap="round" />
            {[[-20, -24, 20], [8, -28, -12], [22, 4, 30], [-24, 10, -8], [-2, 22, 15], [4, -4, 40]].map(([x, y, r]) => (
              <rect x={x - 7} y={y - 7} width="14" height="14" rx="3" fill="#FFF7E8" stroke="#E7C79C" transform={`rotate(${r} ${x} ${y})`} />
            ))}
            {[[-34, -16], [30, -20], [16, 30], [-12, 36]].map(([x, y]) => <ellipse cx={x} cy={y} rx="5" ry="3" fill="#3E8E3E" />)}
          </>
        )}
        {k.id === 'dal' && (
          <>
            <circle r="52" fill={`url(#${u('dal')})`} />
            <path d="M-26 0c0-16 26-24 36-8s-6 30-20 24-10-22 4-20" stroke="#F6E6C8" stroke-width="4" fill="none" stroke-linecap="round" />
            <ellipse cx="16" cy="-18" rx="9" ry="6" fill="#FFE9A0" />
            {[[-30, 24], [24, 20], [-6, -34]].map(([x, y]) => <ellipse cx={x} cy={y} rx="4" ry="2.5" fill="#3E8E3E" />)}
          </>
        )}
        {k.id === 'chaat' && (
          <>
            <circle r="52" fill="#E9D3A6" />
            {[[-20, -20], [14, -24], [28, 6], [6, 28], [-24, 16], [-2, 0]].map(([x, y]) => (
              <g transform={`translate(${x} ${y})`}>
                <circle r="15" fill={`url(#${u('puri')})`} stroke="#A0621E" stroke-width="1" />
                <ellipse cx="2" cy="1" rx="6" ry="5" fill="#5E3410" />
                <ellipse cx="2" cy="0" rx="3.5" ry="2.5" fill="#7FB04A" />
              </g>
            ))}
            {Array.from({ length: 18 }, (_, i) => {
              const a = i * 1.7;
              const r = 12 + (i * 5) % 34;
              return <line x1={r * Math.cos(a)} y1={r * Math.sin(a)} x2={r * Math.cos(a) + 5} y2={r * Math.sin(a) + 2} stroke="#F2C230" stroke-width="2.2" stroke-linecap="round" />;
            })}
          </>
        )}
        {k.id === 'global' && (
          <>
            <circle r="52" fill="#C98A36" />
            <circle r="44" fill="#E9B456" />
            <circle r="40" fill="#D4532A" fill-opacity=".55" />
            {[[-14, -18, 14], [16, -10, 12], [-4, 14, 15], [22, 18, 9], [-24, 6, 9]].map(([x, y, r]) => <ellipse cx={x} cy={y} rx={r} ry={r * 0.8} fill="#FBE3A0" />)}
            {[[-20, -2], [8, -26], [26, -2], [-6, 30]].map(([x, y]) => <circle cx={x} cy={y} r="4.5" fill="none" stroke="#2A2A22" stroke-width="2.4" />)}
            {[[2, -6], [-28, -20], [18, 28]].map(([x, y]) => <path d={`M${x - 6} ${y}a6 6 0 0 1 12 0`} stroke="#3E8E3E" stroke-width="3" fill="none" />)}
            {[[-10, 24], [28, -20]].map(([x, y]) => <rect x={x} y={y} width="8" height="5" rx="1.5" fill="#C2321F" />)}
            {[0, 60, 120].map((a) => <line x1={-44 * Math.cos((a * Math.PI) / 180)} y1={-44 * Math.sin((a * Math.PI) / 180)} x2={44 * Math.cos((a * Math.PI) / 180)} y2={44 * Math.sin((a * Math.PI) / 180)} stroke="#A8692A" stroke-opacity=".5" stroke-width="1.5" />)}
          </>
        )}
        {k.id === 'mithai' && (
          <>
            <circle r="52" fill="#F6E7C8" />
            <path d="M-40 18c20 10 50 12 80-4" stroke="#EAD3A4" stroke-width="10" fill="none" stroke-linecap="round" />
            {[[-17, -15, 20], [17, -10, 140], [0, 19, 260]].map(([x, y, r]) => (
              <g transform={`translate(${x} ${y}) rotate(${r})`}>
                <path d={spiral(2.6, 6.2)} fill="none" stroke="#B4500C" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d={spiral(2.6, 6.2)} fill="none" stroke="#F39A2B" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
                <path d={spiral(2.6, 6.2)} fill="none" stroke="#FFD27A" stroke-opacity=".6" stroke-width="1.6" stroke-linecap="round" transform="translate(-1 -1)" />
              </g>
            ))}
            {[[-34, 14], [30, 26], [33, -28], [-10, -38]].map(([x, y]) => <ellipse cx={x} cy={y} rx="4" ry="2" fill="#94BF52" transform={`rotate(30 ${x} ${y})`} />)}
          </>
        )}
        {k.id === 'drinks' && (
          <>
            <circle r="52" fill={`url(#${u('sharbat')})`} />
            <circle r="34" fill="none" stroke="#FFF6DD" stroke-opacity=".6" stroke-width="2" />
            {[[-14, -10, 20], [10, -18, -30], [18, 10, 60], [-8, 16, 10]].map(([x, y, r]) => <ellipse cx={x} cy={y} rx="7" ry="3" fill="#FBF3E0" transform={`rotate(${r} ${x} ${y})`} />)}
            {[[-26, -24], [26, -28], [30, 24], [-30, 22], [0, 34]].map(([x, y]) => <line x1={x} y1={y} x2={x + 6} y2={y + 3} stroke="#C8341A" stroke-width="1.6" stroke-linecap="round" />)}
            {[[2, -2], [-22, 4], [24, -6]].map(([x, y]) => <ellipse cx={x} cy={y} rx="6" ry="4" fill="#D8436E" fill-opacity=".85" />)}
          </>
        )}
        {k.id === 'decor' && (
          <>
            <circle r="52" fill="#2F6B3A" />
            {[0, 90, 180, 270].map((a) => <ellipse cx="0" cy="-38" rx="10" ry="20" fill="#3E8E3E" transform={`rotate(${a + 45})`} />)}
            {ring(16, 26).map((p) => <circle cx={p.x} cy={p.y} r="10" fill="#F28C13" />)}
            {ring(12, 16, 0.3).map((p) => <circle cx={p.x} cy={p.y} r="8" fill="#F8A51F" />)}
            {ring(8, 7, 0.1).map((p) => <circle cx={p.x} cy={p.y} r="6" fill="#E46E0A" />)}
            <circle r="5" fill="#C9520A" />
          </>
        )}
      </g>
      <path d="M-46 -30a56 56 0 0 1 40 -26" stroke="#FFFBE6" stroke-opacity=".8" stroke-width="4" stroke-linecap="round" fill="none" />
    </g>
  ))}
</svg>

<style>
  .thali { display: block; width: 100%; height: auto; overflow: visible; }
  .thali :global(.food) {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .thali[data-mode='build'] :global(.katori:not(.is-filled) .food) {
    opacity: 0;
    transform: scale(0.3) rotate(-40deg);
  }
  .thali[data-mode='build'] :global(.katori.is-filled .food) {
    animation: ladle 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes ladle {
    0% { transform: scale(0.3) rotate(-40deg); }
    60% { transform: scale(1.06) rotate(4deg); }
    100% { transform: scale(1) rotate(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .thali :global(.food) { transition: opacity 0.2s linear; }
    .thali[data-mode='build'] :global(.katori:not(.is-filled) .food) { transform: none; }
    .thali[data-mode='build'] :global(.katori.is-filled .food) { animation: none; }
  }
</style>
